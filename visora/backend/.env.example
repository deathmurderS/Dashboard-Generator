# FastAPI service configuration
# The ONLY environment variable the backend reads.
# Comma-separated list of allowed browser origins (frontend domains).
# Local development:
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# On Render, set it to your production frontend origin(s), e.g.:
# CORS_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com
#
# Note: SUPABASE_URL / SUPABASE_SERVICE_KEY are NOT used by this service —
# the profiler and recommender are stateless and never touch the database.
