# ─── Database ──────────────────────────────────────────────────────────────
# Local development (Docker)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5434/dashboard_generator

# Railway: paste DATABASE_URL dari Railway dashboard (otomatis pakai SSL)
# DATABASE_URL=postgresql://postgres:xxx@xxx.railway.app:5432/railway
# (Railway akan otomatis inject DATABASE_URL, jadi gak perlu di-set manual)

# ─── JWT ────────────────────────────────────────────────────────────────────
# WAJIB ganti dengan string random panjang di Railway!
SECRET_KEY=ubah-ini-jadi-string-random-panjang
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── CORS ───────────────────────────────────────────────────────────────────
# Di Railway (satu service), bisa dikosongin atau isi domain Railway aja
# Contoh: https://my-app.up.railway.app
CORS_ORIGINS=
